{
  "name": "redux-persist",
  "version": "6.1.0",
  "description": "persist and rehydrate redux stores",
  "main": "lib/index.js",
  "module": "es/index.js",
  "types": "lib/index.d.ts",
  "repository": "rt2zz/redux-persist",
  "files": [
    "src",
    "es",
    "lib",
    "dist",
    "integration",
    "README.md"
  ],
  "scripts": {
    "ava": "ava",
    "build": "npm run build:commonjs && npm run build:es && npm run build:umd",
    "build:commonjs": "tsc --module commonjs --outDir lib",
    "build:es": "tsc --module es2015 --outDir es",
    "build:umd": "rollup -c",
    "clean": "rimraf build dist es lib",
    "prepare": "npm run build",
    "stats:size": "node ./scripts/size-estimator.js",
    "test": "tsc -p tsconfig.test.json && ava",
    "version": "npm run clean && npm run build && npm run stats:size | tail -1 >> LIBSIZE.md && git add LIBSIZE.md",
    "lint": "eslint src tests",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "author": "",
  "license": "MIT",
  "homepage": "https://github.com/rt2zz/redux-persist#readme",
  "ava": {
    "files": [
      "tests/**/*.spec.ts"
    ],
    "typescript": {
      "rewritePaths": {
        "tests/": "build/tests/"
      },
      "compile": false
    }
  },
  "devDependencies": {
    "@ava/typescript": "^7.0.0",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/redux-mock-store": "^1.5.0",
    "@types/sinon": "^22.0.0",
    "ava": "^8.0.1",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "redux": "^4.2.1",
    "redux-mock-store": "^1.5.5",
    "rimraf": "^6.1.3",
    "rollup": "^4.64.0",
    "sinon": "^22.1.0",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "peerDependencies": {
    "redux": ">4.0.0"
  }
}
